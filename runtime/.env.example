PORT=8787
RUNTIME_DEFAULT_MODE=live
CORS_ORIGIN=https://flappylz.github.io

# LiveKit server credentials. Keep these in the runtime secret store.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_ID=

# ElevenLabs server credentials. Never expose them to the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_CARRIER=
ELEVENLABS_VOICE_ID_AIRLINE=
ELEVENLABS_VOICE_ID_FOOTBALL=

# Optional if the Agent worker uses an OpenAI model/provider.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
