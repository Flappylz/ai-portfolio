PORT=8787
RUNTIME_DEFAULT_MODE=live
CORS_ORIGIN=https://flappylz.github.io
# Cloudflare Worker binding (configure as a KV namespace named TRACE_KV in the deployment)
LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_FAST_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_SLOW_LLM_MODEL=openai/gpt-5.6-sol
LIVEKIT_SLOW_INFERENCE_CLASS=low
LIVEKIT_DEEP_TIMEOUT_MS=3200
LIVEKIT_SLOW_REASONING_EFFORT=low
LIVEKIT_SPECULATIVE_LOOKUP=true
LIVEKIT_STT_MODEL=openai/gpt-live-transcribe
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_ALLOWED_MODELS=eleven_flash_v2_5,eleven_turbo_v2_5,eleven_v4_turbo

# LiveKit server credentials. Keep these in the runtime secret store.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_ID=

# ElevenLabs server credentials. Never expose them to the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_CARRIER=
ELEVENLABS_VOICE_ID_AIRLINE=
ELEVENLABS_VOICE_ID_FOOTBALL=

# Optional if the Agent worker uses an OpenAI model/provider.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
